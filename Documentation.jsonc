  // ==========================
  // CHATBOT (Context-Aware AI Assistant - FastText)
  // ==========================
  // السيناريو: الفلاتر يبعت الرسالة فقط. لارافل بيجمع كل بيانات المستخدم وحالته الصحية والكرسي والرحلة
  // ويبعتهم سراً مع الرسالة للـ Python AI عشان يرد رد طبي ذكي ودقيق.
  // البوت يكتشف اللغة (عربي/إنجليزي) تلقائياً عبر fastText - لا حاجة لإرسال بارامتر language.
  {
    "endpoint": "GET /api/chatbot/sessions",
    "description": "Get all chatbot sessions for the authenticated user",
    "request": {},
    "response": {
      "message": "Chat sessions retrieved successfully.",
      "data": [
        {
          "id": 1,
          "title": "New Chat",
          "user_id": 1
        }
      ]
    }
  },
  {
    "endpoint": "POST /api/chatbot/sessions",
    "description": "Create a new chatbot session",
    "request": {
      "title": "My first chat"
    },
    "response": {
      "message": "Chat session created",
      "data": {
        "id": 1,
        "title": "My first chat",
        "user_id": 1
      }
    }
  },
  {
    "endpoint": "GET /api/chatbot/sessions/{session}",
    "description": "Get a specific chatbot session including its messages",
    "request": {},
    "response": {
      "message": "Session retrieved successfully.",
      "data": {
        "id": 1,
        "title": "My first chat",
        "messages": [
          {
            "id": 1,
            "sender_type": "user",
            "content": "انا حاسس بتعب"
          },
          {
            "id": 2,
            "sender_type": "bot",
            "content": "سلامتك يا أحمد. ألاحظ أن نبضات قلبك مرتفعة."
          }
        ]
      }
    }
  },
  {
    "endpoint": "DELETE /api/chatbot/sessions/{session}",
    "description": "Delete a chatbot session",
    "request": {},
    "response": {
      "message": "Chat session deleted successfully",
      "data": []
    }
  },
  {
    "endpoint": "POST /api/chatbot/sessions/{session}/chat",
    "description": "Send a message to the AI chatbot. Flutter sends ONLY the message. Laravel automatically collects user profile, health state, wheelchair status, trip info, doctor, companions, and latest alerts and sends them as hidden context to the Python AI service.",
    "headers": {
      "Authorization": "Bearer {user_token}",
      "Accept": "application/json"
    },
    "path_parameters": {
      "session": "Integer (The Chat Session ID)"
    },
    "body": {
      "message": "انا حاسس بتعب ومش عارف اروح فين", // (example: String)
      "media": "(file upload optional array)"
    },
    // هذا الكائن لا يرسله الفلاتر — لارافل يبنيه تلقائياً ويرسله للبايثون خلف الكواليس
    "backend_context_payload_sent_to_ai": {
      "user_text": "انا حاسس بتعب ومش عارف اروح فين", // (example: String)
      "context": {
        "user_profile": {
          "name": "Ahmed", // (example: String)
          "medical_condition": "Lower Body Paralysis", // (example: String)
          "age": 28, // (example: Integer)
          "weight": 70, // (example: Integer)
          "gender": "male" // (options: "male", "female")
        },
        "relations": {
          "doctor": { "name": "Dr. Smith", "phone": "+201111111" },
          "companions": [
            { "name": "Mona", "phone": "+201222222" }
          ]
        },
        "wheelchair_status": {
          "serial_number": "CHAIR-001", // (example: String)
          "battery": 80, // (example: Integer 0-100)
          "connection": "online" // (options: "online", "offline")
        },
        "current_health_state": {
          "heart_rate": 110, // (example: Integer)
          "temperature": 37.5, // (example: Float)
          "mpu_monitoring": {
            "angle": 45, // (example: Float)
            "fall_detected": true // (options: true, false)
          }
        },
        "current_trip": {
          "is_active": true, // (options: true, false)
          "destination": "Hospital", // (example: String)
          "current_coordinates": { "x": 10.5, "y": 20.2 } // (example: Floats)
        },
        "latest_alerts": {
          "heart": { "message": "High Heart Rate Detected", "severity": "critical", "timestamp": "2026-05-28T13:10:00Z" }, // (severity options: "normal", "medium", "critical")
          "temperature": null,
          "mpu_monitoring": { "message": "High Fall Risk", "severity": "critical", "timestamp": "2026-05-28T13:15:00Z" },
          "obstacle": { "message": "Stairs ahead", "severity": "medium", "timestamp": "2026-05-28T09:50:00Z" },
          "sos": null,
          "battery": { "message": "Battery below 20%", "severity": "medium", "timestamp": "2026-05-28T08:00:00Z" }
        }
      }
    },
    "response": {
