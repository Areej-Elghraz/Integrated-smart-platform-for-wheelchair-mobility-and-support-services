        "id": 2,
        "sender_type": "bot",
        "content": "سلامتك يا أحمد. ألاحظ أن نبضات قلبك مرتفعة قليلاً وبطاريتك كويسة. هل تحب أن أرسل رسالة استغاثة (SOS) للمرافقة منى؟"
      },
      "intent": "health_complaint", // (options: "greeting", "health_complaint", "navigation", "emergency", "general")
      "confidence": 0.98, // (example: Float 0.0 to 1.0)
      "language": "ar" // (options: "ar", "en")
    }
  },
  {
    "endpoint": "POST /api/chatbot/messages/{message}/reaction",
